# 🔒 APIC Environment Configuration Template
# Copy this to .env.local and fill with real values
# NEVER commit real secrets — use Doppler, Infisical, or GitHub Secrets

# ========================================
# DATABASE (Supabase PostgreSQL)
# ========================================
DATABASE_URL=postgresql://user:password@localhost:5432/apic_dev
DATABASE_DIRECT_URL=postgresql://user:password@localhost:5432/apic_dev
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ========================================
# AUTHENTICATION
# ========================================
JWT_SECRET=your-super-secret-jwt-key-here-min-32-chars
JWT_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=30d

# ========================================
# NEXA AI GATEWAY
# ========================================
NEXA_API_URL=https://api.nexa.ai
NEXA_API_KEY=sk-nexa-xxxxxxxxxxxxxxxxxxxxx
NEXA_TIMEOUT_MS=30000

# ========================================
# PAYMENT (Manual Only for V1)
# ========================================
# No payment gateways configured for V1
# STRIPE_KEY=...
# STRIPE_SECRET=...

# ========================================
# SECRETS & KMS
# ========================================
# Use Doppler or Infisical in production
DOPPLER_TOKEN=
INFISICAL_TOKEN=

# ========================================
# INFRASTRUCTURE
# ========================================
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# ========================================
# LOGGING & OBSERVABILITY
# ========================================
LOG_LEVEL=debug
CORRELATION_ID_ENABLED=true

# ========================================
# TESTING
# ========================================
JEST_ENVIRONMENT=node
TEST_DATABASE_URL=postgresql://test:test@localhost:5432/apic_test
TEST_TIMEOUT=30000

# ========================================
# EXTERNAL SERVICES (Phase 9+)
# ========================================
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_API_URL=https://graph.instagram.com/v18.0
# WHATSAPP_API_TOKEN=

# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=noreply@apic.diyanotech.com
