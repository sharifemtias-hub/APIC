{
  "name": "apic",
  "version": "1.0.0",
  "description": "APIC — AI-Powered Inventory Controller. Secure business management for SMEs.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "01_APPS/*",
    "02_SHARED_CORE/*",
    "03_BUSINESS_MODULES/*",
    "04_AI/*",
    "05_ENGINES/*",
    "06_DATABASE",
    "07_INFRASTRUCTURE",
    "08_TESTS"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:watch": "pnpm -r run test:watch",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "type-check": "pnpm -r run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "pnpm -r run clean && rm -rf node_modules",
    "setup": "pnpm install && pnpm type-check && pnpm test"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  }
}
